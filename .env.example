# Copy to .env. No LLM key anywhere.
GITLAB_URL=https://gitlab.com
GITLAB_PROJECT=group/project
GITLAB_TOKEN=            # read_api scope; needed for comments and private projects
GITLAB_INCLUDE_COMMENTS=true
COGNEE_DATASET=gitlab_project
POSTGRES_PASSWORD=cognee
SYNC_INTERVAL_SECONDS=0  # 0 = one sync per `compose run`; >0 = loop inside the container
