# Optional: `docker compose up -d` works without this file. Export GITLAB_PROJECT (and GITLAB_TOKEN
# for comments) or copy this to .env before `docker compose run --rm sync`. No LLM key anywhere.
GITLAB_URL=https://gitlab.com
GITLAB_PROJECT=group/project
GITLAB_TOKEN=            # read_api scope; needed for comments and private projects
GITLAB_INCLUDE_COMMENTS=true
COGNEE_DATASET=gitlab_project
POSTGRES_PASSWORD=cognee
SYNC_INTERVAL_SECONDS=0  # 0 = one sync per `compose run`; >0 = loop inside the container
SYNC_DATA_PER_BATCH=4    # documents cognified at once
SYNC_CHUNKS_PER_BATCH=4  # chunks per GLiNER call; ~250 MiB each on top of a 2.7 GiB base (README "Resources")
SYNC_MEM_LIMIT=5g          # measured peak 4.5 GiB (comments on) + ~10 %
SYNC_MEM_RESERVATION=3g    # 2.7 GiB model baseline + one batch
SYNC_CPUS=4                # the VM has 4; the sync is embarrassingly parallel
FAKE_GITLAB_PER_PAGE_MAX=10  # offline stand-in pages the 24-item fixture
ONTOLOGY_FILE_PATH=/app/ontology/gitlab.owl  # closed GLiNER schema; unset for the open label bank
